{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Bijlage",
  "properties": {
    "id": {
      "type": "string",
      "nullable": true
    },
    "titel": {
      "type": "string",
      "nullable": true
    },
    "url": {
      "type": "string",
      "nullable": true,
      "format": "url"
    },
    "documentText": {
      "type": "string",
      "nullable": true
    },
    "status": {
      "type": "string",
      "nullable": true
    },
    "type": {
      "type": "string",
      "nullable": true
    },
    "categorie": {
      "type": "string",
      "nullable": true
    },
    "extension": {
      "type": "string",
      "nullable": true
    }
  },
  "required": ["titel"]
}
