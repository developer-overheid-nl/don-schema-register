{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Publicatie",
  "properties": {
    "id": {
      "type": "string",
      "nullable": true
    },
    "titel": {
      "type": "string",
      "nullable": true
    },
    "beschrijving": {
      "type": "string",
      "nullable": true
    },
    "samenvatting": {
      "type": "string",
      "nullable": true
    },
    "categorie": {
      "type": "string",
      "nullable": true
    },
    "gepubliceerd": {
      "type": "boolean",
      "default": true
    },
    "portalUrl": {
      "type": "string",
      "nullable": true,
      "format": "url"
    },
    "publicatiedatum": {
      "type": "string",
      "nullable": true,
      "description": "Publicatiedatum van een Woo object is nooit in de toekomst."
    },
    "organisatie": {
      "$ref": "./Organisatie.schema.json"
    },
    "bijlagen": {
      "type": "array",
      "items": {
        "$ref": "./Bijlage.schema.json"
      }
    },
    "metadata": {
      "$ref": "./Metadata.schema.json"
    },
    "themas": {
      "type": "array",
      "nullable": true,
      "items": {
        "$ref": "Thema.schema.json"
      }
    }
  },
  "required": ["categorie", "publicatiedatum"]
}
