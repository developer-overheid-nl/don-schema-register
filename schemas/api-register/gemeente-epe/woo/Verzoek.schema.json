  "title": "Verzoek",
  "properties": {
    "status": {
      "type": "string",
      "nullable": true
    },
    "besluit": {
      "$ref": "./Bijlage.schema.json"
    },
    "informatieverzoek": {
      "$ref": "./Bijlage.schema.json"
    },
    "inventarisatielijst": {
      "$ref": "./Bijlage.schema.json"
