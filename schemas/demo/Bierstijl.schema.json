{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.don.apps.digilab.network/demo/bierstijl",
  "title": "Bierstijl",
  "description": "Bierstijl",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unieke identifier",
      "examples": ["046b6c7f-0b8a-43b9-b35d-6489e6daee91"]
    },
    "naam": {
      "type": "string",
      "description": "Naam",
      "examples": ["Quadrupel"]
    }
  },
  "required": ["id", "naam"],
  "additionalProperties": false
}