          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SchemaDialect"
          }
        },
        "explode": true
      },
      "RootTypeFilter": {
        "name": "rootType",
        "in": "query",
        "description": "Filter schemas by root type. Repeat the parameter to filter on multiple root types.",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/SchemaRootType"
          }
        },
        "explode": true
      },
      "SourceMetaRootFilter": {
        "name": "sourceMetaRoot",
        "in": "query",
        "description": "Filter SourceMeta schemas by the first segment of their SourceMeta path. Repeat the parameter to filter on multiple roots.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explode": true
      },
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the schema",
        "schema": {
          "$ref": "#/components/schemas/ResourceId"
        }
      }
    },
    "headers": {
      "APIVersion": {
        "description": "Semver of this API",
        "schema": {
          "type": "string",
          "example": "1.0.0",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "externalDocs": {
            "description": " /core/version-header: Return the full version number in a response header",
            "url": "https://logius-standaarden.github.io/API-Design-Rules/#/core/version-header"
          }
        }
      },
      "Link": {
        "description": "Links to the previous, next, last or first pages",
