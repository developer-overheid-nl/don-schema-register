{
  "openapi": "3.1.0",
  "info": {
    "title": "Schema-register API v1",
    "version": "1.0.0",
    "contact": {
      "email": "developer.overheid@geonovum.nl",
      "name": "Team developer.overheid.nl",
      "url": "https://github.com/developer-overheid-nl/don-schema-register/issues"
    },
    "description": "API to access the Schema register of developer.overheid.nl.\n\n## Auth\n\nThis API distinguishes between public and private endpoints.\nPublic endpoints can be accessed with either an API key or a client credentials token.\nPrivate endpoints can only be accessed with a client credentials token.\n\n### API key\n\nUsing an API key, you can access all public endpoints of the Schema register.\nThese requests can also be made from the browser.\nRequest a read-only API key at https://apis.developer.overheid.nl/apis/key-aanvragen.\nSimply pass the obtained API key with each request using the `X-Api-Key` header.\n\n### Client credentials token\n\nUsing a client credentials token, you can access both public and private endpoints of the Schema register.\nTo obtain the token, you need to perform a `POST` request to `https://auth.developer.overheid.nl/realms/don/protocol/openid-connect/token` with the following Form URL Encoded body:\n- `grant_type`: `client_credentials`\n- `scope`: depending on the access you need and the client you are, you can request one or more of the following scopes:\n  - `schemas:read`\n  - `schemas:write`\n  - `organisations:read`\n  - `organisations:write`\n- `client_id`: the client id you received from us\n- `client_secret`: the client secret you received from us\n\nPass the obtained token with each request using the `Authorization` header. Example:\n\n`Authorization`: `Bearer {ACCESS_TOKEN}` (replace `{ACCESS_TOKEN}` with the obtained `access_token`)\n\n## Pagination\n\nPagination of collections is done using the `Link` header.\nThere are various libraries available (such as [parse-link-header](https://www.npmjs.com/package/parse-link-header) for Javascript) that can parse this header.\nAdditionally, the following headers provide extra support for implementing pagination in the client:\n- `Current-Page`: the current page in the collection\n- `Per-Page`: the number of items per page\n- `Total-Count`: the total number of items\n- `Total-Pages`: the total number of pages"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://api.developer.overheid.nl/schema-register/v1"
    },
    {
      "description": "Test",
      "url": "https://api.don.apps.digilab.network/schema-register/v1"
    }
  ],
  "paths": {
    "/schemas": {
      "get": {
        "tags": [
          "Public endpoints",
          "Schemas"
        ],
        "summary": "List schemas",
        "description": "Returns a list of JSON Schemas included in the register. Supports the same filter query parameters as the schema filter endpoint.",
        "operationId": "listSchemas",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/SearchFilter"
          },
          {
            "$ref": "#/components/parameters/DialectFilter"
          },
          {
            "$ref": "#/components/parameters/RootTypeFilter"
          },
          {
            "$ref": "#/components/parameters/SourceMetaRootFilter"
          }
        ],
        "responses": {
          "200": {
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              },
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "Total-Count": {
                "$ref": "#/components/headers/TotalCount"
              },
              "Current-Page": {
                "$ref": "#/components/headers/CurrentPage"
              },
              "Per-Page": {
                "$ref": "#/components/headers/PerPage"
              },
              "Total-Pages": {
                "$ref": "#/components/headers/TotalPages"
              }
            },
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SchemaSummary"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      },
      "post": {
        "tags": [
          "Private endpoints",
          "Schemas"
        ],
        "summary": "Create schema",
        "description": "Register a new JSON Schema in the register. The schema is fetched from schemaUrl (or read from schemaBody), validated and stored together with derived metadata (title, description, dialect, root type and a content hash).",
        "operationId": "createSchema",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemaPost"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaSummary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "security": [
          {
            "clientCredentials": [
              "schemas:write"
            ]
          }
        ]
      }
    },
    "/schemas/filters": {
      "get": {
        "tags": [
          "Public endpoints",
          "Schemas"
        ],
        "summary": "List schema filters",
        "description": "Returns all available filter options with counts. Counts are calculated based on the active filters and the optional search term q.",
        "operationId": "listSchemaFilters",
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchFilter"
          },
          {
            "$ref": "#/components/parameters/DialectFilter"
          },
          {
            "$ref": "#/components/parameters/RootTypeFilter"
          },
          {
            "$ref": "#/components/parameters/SourceMetaRootFilter"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FilterGroup"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/schemas/{id}": {
      "get": {
        "tags": [
          "Public endpoints",
          "Schemas"
        ],
        "summary": "Get schema by id",
        "description": "Returns a single JSON Schema based on its id, including the stored schema content.",
        "operationId": "getSchemaById",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Private endpoints",
          "Schemas"
        ],
        "summary": "Update schema",
        "description": "Re-fetches the JSON Schema from schemaUrl (or reads it from schemaBody) and updates the registered schema. The organisationUri must match the owner of the schema.",
        "operationId": "updateSchema",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchemaPost"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchemaSummary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "clientCredentials": [
              "schemas:write"
            ]
          }
        ]
      }
    },
    "/schemas/{id}/schema.json": {
      "get": {
        "tags": [
          "Public endpoints",
          "Schemas"
        ],
        "summary": "Get raw schema content",
        "description": "Returns the raw stored JSON Schema document.",
        "operationId": "getSchemaContent",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "content": {
              "application/schema+json": {
                "schema": {
                  "type": "object",
                  "description": "The stored JSON Schema document"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/organisations": {
      "get": {
        "security": [
          {
            "apiKey": []
          },
          {
            "clientCredentials": [
              "organisations:read"
            ]
          }
        ],
        "tags": [
          "Public endpoints",
          "Organisations"
        ],
        "summary": "List organisations",
        "description": "List organisations",
        "operationId": "listOrganisations",
        "responses": {
          "200": {
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              },
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "Total-Count": {
                "$ref": "#/components/headers/TotalCount"
              },
              "Current-Page": {
                "$ref": "#/components/headers/CurrentPage"
              },
              "Per-Page": {
                "$ref": "#/components/headers/PerPage"
              },
              "Total-Pages": {
                "$ref": "#/components/headers/TotalPages"
              }
            },
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganisationSummary"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          }
        ]
      },
      "post": {
        "security": [
          {
            "clientCredentials": [
              "organisations:write"
            ]
          }
        ],
        "tags": [
          "Private endpoints",
          "Organisations"
        ],
        "summary": "Create organisation",
        "description": "Create a new organisation.",
        "operationId": "createOrganisation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationSummary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/APIVersion"
              }
            },
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationSummary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemJson": {
        "title": "Problem JSON",
        "description": "Problem JSON schema representing errors and status code",
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "The HTTP status code generated by the origin server for this occurrence of the problem",
            "example": 400
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type",
            "example": "Request validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "List of errors encountered during processing",
              "properties": {
                "in": {
                  "type": "string",
                  "description": "Location of the error (e.g., body, query, header)",
                  "enum": [
                    "body",
                    "query"
                  ]
                },
                "location": {
                  "type": "string",
                  "description": "Location in the document where the error occurred (JSON Pointer)",
                  "example": "#/foo[0]/bar"
                },
                "code": {
                  "type": "string",
                  "description": "A code representing the type of error",
                  "example": "date.format"
                },
                "detail": {
                  "type": "string",
                  "description": "A detailed message describing the error",
                  "example": "must be ISO 8601"
                }
              },
              "required": [
                "in",
                "location",
                "code",
                "detail"
              ]
            }
          }
        },
        "required": [
          "status",
          "title"
        ]
      },
      "ResourceId": {
        "type": "string",
        "description": "Unique identifier of the schema",
        "examples": [
          "demo-bier"
        ]
      },
      "OrganisationUri": {
        "title": "Organisation URI",
        "description": "The unique identifier for an organisation",
        "type": "string",
        "format": "uri",
        "example": "https://developer.overheid.nl"
      },
      "SchemaUrl": {
        "type": "string",
        "format": "uri",
        "description": "Location of the JSON Schema document",
        "examples": [
          "https://schemas.example.org/Bier.schema.json"
        ]
      },
      "SchemaTitle": {
        "type": "string",
        "description": "Title of the JSON Schema (taken from the schema's title keyword)",
        "examples": [
          "Bier"
        ]
      },
      "SchemaDescription": {
        "type": "string",
        "description": "Description of the JSON Schema (taken from the schema's description keyword)",
        "examples": [
          "Het specifieke bier dat een brouwerij produceert"
        ]
      },
      "SchemaDialect": {
        "type": "string",
        "description": "Normalised JSON Schema dialect, derived from the $schema keyword",
        "enum": [
          "2020-12",
          "2019-09",
          "draft-07",
          "draft-06",
          "draft-04",
          "oas-3.1",
          "unknown"
        ],
        "examples": [
          "2020-12"
        ]
      },
      "SchemaRootType": {
        "type": "string",
        "description": "Root type of the JSON Schema, derived from the top-level type keyword",
        "enum": [
          "object",
          "array",
          "string",
          "number",
          "integer",
          "boolean",
          "null",
          "unknown"
        ],
        "examples": [
          "object"
        ]
      },
      "SchemaCollection": {
        "type": "string",
        "description": "Optional collection the schema belongs to",
        "examples": [
          "demo"
        ]
      },
      "CreatedAt": {
        "type": "string",
        "format": "date-time",
        "readOnly": true
      },
      "LastCrawledAt": {
        "type": "string",
        "format": "date-time",
        "readOnly": true
      },
      "OrganisationSummary": {
        "title": "Organisation summary",
        "description": "An organisation from the catalog",
        "type": "object",
        "properties": {
          "uri": {
            "$ref": "#/components/schemas/OrganisationUri"
          },
          "label": {
            "description": "The label of the organisation",
            "type": "string",
            "example": "developer.overheid.nl"
          }
        },
        "required": [
          "uri",
          "label"
        ]
      },
      "Contact": {
        "type": "object",
        "description": "Contact information of the schema maintainer",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "Team developer.overheid.nl"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "examples": [
              "developer.overheid@geonovum.nl"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "examples": [
              "https://developer.overheid.nl"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "SourceMetaDependency": {
        "type": "object",
        "description": "A dependency edge reported by SourceMeta for a stored schema.",
        "properties": {
          "from": {
            "type": "string",
            "format": "uri",
            "description": "The schema identifier that contains the reference"
          },
          "to": {
            "type": "string",
            "format": "uri",
            "description": "The schema identifier being referenced"
          },
          "at": {
            "type": "string",
            "description": "JSON Pointer location of the dependency"
          },
          "fromSchemaId": {
            "$ref": "#/components/schemas/ResourceId",
            "description": "Local schema-register id for the dependency source, when available"
          },
          "fromSchemaUrl": {
            "type": "string",
            "description": "Frontend path for the dependency source schema, for example schemas/{id}, when available"
          },
          "fromSchemaTitle": {
            "$ref": "#/components/schemas/SchemaTitle",
            "description": "Local schema-register title for the dependency source, when available"
          },
          "toSchemaId": {
            "$ref": "#/components/schemas/ResourceId",
            "description": "Local schema-register id for the dependency target, when available"
          },
          "toSchemaUrl": {
            "type": "string",
            "description": "Frontend path for the dependency target schema, for example schemas/{id}, when available"
          },
          "toSchemaTitle": {
            "$ref": "#/components/schemas/SchemaTitle",
            "description": "Local schema-register title for the dependency target, when available"
          }
        },
        "required": [
          "from",
          "to",
          "at"
        ]
      },
      "SourceMetaHealthIssue": {
        "type": "object",
        "description": "A health issue reported by the SourceMeta One API health endpoint.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Identifier name of the health issue"
          },
          "message": {
            "type": "string",
            "description": "Human-readable health issue message"
          },
          "description": {
            "type": "string",
            "description": "Additional health issue description"
          },
          "pointers": {
            "type": "array",
            "description": "JSON Pointer locations where the issue occurs",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "message",
          "pointers"
        ]
      },
      "SchemaSummary": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "schemaUrl": {
            "$ref": "#/components/schemas/SchemaUrl"
          },
          "title": {
            "$ref": "#/components/schemas/SchemaTitle"
          },
          "description": {
            "$ref": "#/components/schemas/SchemaDescription"
          },
          "dialect": {
            "$ref": "#/components/schemas/SchemaDialect"
          },
          "rootType": {
            "$ref": "#/components/schemas/SchemaRootType"
          },
          "collection": {
            "$ref": "#/components/schemas/SchemaCollection"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "createdAt": {
            "$ref": "#/components/schemas/CreatedAt"
          },
          "lastCrawledAt": {
            "$ref": "#/components/schemas/LastCrawledAt"
          },
          "sourceMetaName": {
            "type": "string",
            "description": "Name reported by the SourceMeta One API entry"
          },
          "sourceMetaPath": {
            "type": "string",
            "description": "Relative SourceMeta schema path without the leading /schemas base"
          },
          "sourceMetaRoot": {
            "type": "string",
            "description": "First path segment of sourceMetaPath, used for filtering"
          },
          "sourceMetaBundledUrl": {
            "type": "string",
            "format": "uri",
            "description": "Public URL for downloading the bundled schema"
          },
          "sourceMetaIdentifier": {
            "type": "string",
            "format": "uri",
            "description": "Identifier reported by the SourceMeta One API entry"
          },
          "sourceMetaBytes": {
            "type": "integer",
            "description": "Original schema size in bytes reported by SourceMeta"
          },
          "sourceMetaBytesBundled": {
            "type": "integer",
            "description": "Bundled schema size in bytes reported by SourceMeta"
          },
          "sourceMetaBaseDialect": {
            "type": "string",
            "description": "Base dialect reported by SourceMeta"
          },
          "sourceMetaDialect": {
            "type": "string",
            "description": "Dialect reported by SourceMeta"
          },
          "sourceMetaHealth": {
            "type": "integer",
            "description": "Health score reported by SourceMeta"
          },
          "sourceMetaDependencies": {
            "type": "integer",
            "description": "Number of dependencies reported by SourceMeta"
          }
        },
        "required": [
          "id",
          "title"
        ]
      },
      "SchemaDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SchemaSummary"
          },
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "object",
                "description": "The stored JSON Schema document"
              },
              "sourceMetaDependencyDetails": {
                "type": "array",
                "description": "Dependency edges reported by SourceMeta for this schema",
                "items": {
                  "$ref": "#/components/schemas/SourceMetaDependency"
                }
              },
              "sourceMetaHealthIssues": {
                "type": "array",
                "description": "Health issues reported by SourceMeta for this schema",
                "items": {
                  "$ref": "#/components/schemas/SourceMetaHealthIssue"
                }
              }
            }
          }
        ]
      },
      "SchemaPost": {
        "type": "object",
        "description": "Register a JSON Schema by URL or by providing the schema body directly. Either schemaUrl or schemaBody is required.",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ResourceId"
          },
          "schemaUrl": {
            "$ref": "#/components/schemas/SchemaUrl"
          },
          "schemaBody": {
            "type": "string",
            "description": "The JSON Schema document itself, as a JSON string. Required when schemaUrl is omitted."
          },
          "organisationUri": {
            "$ref": "#/components/schemas/OrganisationUri"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          }
        },
        "required": [
          "organisationUri",
          "contact"
        ]
      },
      "FilterOption": {
        "type": "object",
        "description": "A single option within a multi-select filter group.",
        "required": [
          "value",
          "label",
          "count",
          "selected"
        ],
        "properties": {
          "value": {
            "type": "string",
            "description": "The filter value to pass as a query parameter."
          },
          "label": {
            "type": "string",
            "description": "Human-readable label for the option."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional description of the filter value."
          },
          "count": {
            "type": "integer",
            "description": "Number of repositories matching this option, given the other active filters."
          },
          "selected": {
            "type": "boolean",
            "description": "Whether this option is currently selected."
          }
        }
      },
      "FilterGroup": {
        "type": "object",
        "description": "A filter group with metadata and available options or current value.",
        "required": [
          "key",
          "label",
          "description",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Unique key of the filter group, matching the query parameter name.",
            "example": "softwareType"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label for the filter group."
          },
          "description": {
            "type": "string",
            "description": "Description of what this filter does."
          },
          "type": {
            "type": "string",
            "enum": [
              "toggle",
              "date",
              "multi-select",
              "single-select"
            ],
            "description": "Filter type. toggle: on/off switch. date: date input (ISO 8601). multi-select: multiple values selectable. single-select: one value selectable from a list."
          },
          "value": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ],
            "description": "Current filter value. For toggle: boolean true or false. For date: ISO 8601 date (yyyy-MM-dd). Not present for multi-select."
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "description": "For toggle filters, the number of repositories with the toggle condition available. For date filters, the number of repositories matching the current date value; only present when a date is set. Not present for multi-select."
          },
          "options": {
            "type": "array",
            "description": "Available options with counts. Only present for multi-select type.",
            "items": {
              "$ref": "#/components/schemas/FilterOption"
            }
          }
        }
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page number (1-based).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PerPage": {
        "name": "perPage",
        "in": "query",
        "required": false,
        "description": "Number of results per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "SearchFilter": {
        "name": "q",
        "in": "query",
        "required": false,
        "description": "Search term to combine with repository filters. Matches repository name, short description, long description, publiccode.yml url and publiccode.yml landingURL.",
        "schema": {
          "type": "string"
        }
      },
      "DialectFilter": {
        "name": "dialect",
        "in": "query",
